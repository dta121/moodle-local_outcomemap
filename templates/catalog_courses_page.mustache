{{!
    Searchable Catalog courses page with program memberships inline.
    @template local_outcomemap/catalog_courses_page

    Context variables required for this template:
    * canmanage boolean Whether the reader may act on catalog courses.
    * canmanageprograms boolean Whether the reader may act on memberships.
    * addurl string URL of the add-catalog-course form.
    * filters array Filter chips with id, label, count, active.
    * rows array Catalog courses with their counts, memberships, actions, and
      an addmembershipurl that preselects the course.
    * hascourses boolean Whether any catalog course exists.
    * statsline string Aggregate summary line.

    Example context (json):
    {
        "canmanage": true,
        "canmanageprograms": true,
        "addurl": "#",
        "filters": [{"id": "all", "label": "All courses", "count": 1, "active": true}],
        "rows": [{
            "id": 7,
            "code": "MBA601",
            "name": "Financial Management",
            "meta": "8 course outcomes · 26 unit outcomes",
            "hasoutcomes": true,
            "instanceline": "2 course instances · 1 finalized",
            "statuslabel": "Finalized",
            "statusclass": "approved",
            "hasprograms": true,
            "programs": [{"code": "MBA", "typeclass": "graduate", "title": "Master of Business Administration"}],
            "memberships": [{
                "code": "MBA",
                "typeclass": "graduate",
                "name": "Master of Business Administration",
                "effective": "From 31 December 2025",
                "statuslabel": "Finalized",
                "statusclass": "approved",
                "cansubmit": false
            }],
            "outcomesurl": "#",
            "instancesurl": "#",
            "addmembershipurl": "#",
            "canedit": false,
            "cansubmit": false,
            "searchtext": "mba601"
        }],
        "hascourses": true,
        "statsline": "1 catalog course"
    }
}}
<div id="lom-catalog" class="lom-page lom-catalog">
    <h2 class="lom-page-title">{{#str}} catalogcourses_heading, local_outcomemap {{/str}}</h2>
    <div class="lom-page-subtitle">{{#str}} catalogcourses_subtitle, local_outcomemap {{/str}}</div>

    <div class="lom-page-toolbar">
        <div class="lom-page-search">
            <span aria-hidden="true">&#128269;</span>
            <input id="lom-catalog-search" type="search" autocomplete="off"
                   placeholder="{{#str}} catalogcourses_searchplaceholder, local_outcomemap {{/str}}"
                   aria-label="{{#str}} catalogcourses_searchplaceholder, local_outcomemap {{/str}}">
        </div>
        <div class="lom-filterchips" role="group" aria-label="{{#str}} catalogcourses_filter_label, local_outcomemap {{/str}}">
            {{#filters}}
            <button type="button" class="lom-filterchip {{#active}}lom-active{{/active}}" data-catalog-filter="{{id}}"
                    aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{label}}
                <span class="lom-filterchip-count">{{count}}</span></button>
            {{/filters}}
        </div>
        {{#canmanage}}
        <a class="lom-page-btn lom-page-btn-primary lom-page-toolbar-end" href="{{addurl}}">{{#str}} addcatalogcourse, local_outcomemap {{/str}}</a>
        {{/canmanage}}
    </div>
    <div class="lom-page-stats">{{statsline}}</div>
    <div id="lom-catalog-noresults" class="lom-page-noresults lom-hidden" role="status" aria-live="polite">{{#str}} catalogcourses_noresults, local_outcomemap {{/str}}</div>

    {{#rows}}
    <article class="lom-cat-card lom-filter-row" data-search="{{searchtext}}"
             data-inprogram="{{#hasprograms}}1{{/hasprograms}}{{^hasprograms}}0{{/hasprograms}}"
             data-hasoutcomes="{{#hasoutcomes}}1{{/hasoutcomes}}{{^hasoutcomes}}0{{/hasoutcomes}}">
        <div class="lom-cat-head lom-row-toggle">
            <button type="button" class="lom-chev" data-lom-toggle aria-expanded="true"
                    aria-controls="lom-cat-panel-{{id}}"
                    data-expand-label="{{#str}} expand, core {{/str}}"
                    data-collapse-label="{{#str}} collapse, core {{/str}}"
                    aria-label="{{#str}} collapse, core {{/str}}">&#9662;</button>
            <span class="lom-code-badge lom-code-catalog">{{code}}</span>
            <span class="lom-cat-summary">
                <span class="lom-cat-name">{{name}}</span>
                <span class="lom-cat-meta">{{meta}} &middot; {{instanceline}}</span>
            </span>
            <span class="lom-cat-programs">
                {{#programs}}
                <span class="lom-code-badge lom-code-type-{{typeclass}}" title="{{title}}">{{code}}</span>
                {{/programs}}
                {{^hasprograms}}
                <span class="lom-workflow lom-workflow-review">{{#str}} catalogcourses_noprogram_chip, local_outcomemap {{/str}}</span>
                {{/hasprograms}}
            </span>
            <span class="lom-workflow lom-workflow-{{statusclass}}">{{statuslabel}}</span>
        </div>
        <div class="lom-cat-panel" id="lom-cat-panel-{{id}}">
            <div class="lom-cat-panel-head">
                <span class="lom-cat-panel-label">{{#str}} catalogcourses_memberships, local_outcomemap {{/str}}</span>
                {{#canmanageprograms}}
                <a href="{{addmembershipurl}}">{{#str}} catalogcourses_addmembership, local_outcomemap {{/str}}</a>
                {{/canmanageprograms}}
            </div>
            {{^hasprograms}}
            <div class="lom-cat-warn">{{#str}} catalogcourses_noprogram_warning, local_outcomemap {{/str}}</div>
            {{/hasprograms}}
            {{#memberships}}
            <div class="lom-cat-membership">
                <span class="lom-code-badge lom-code-type-{{typeclass}}">{{code}}</span>
                <span class="lom-cat-membership-name">{{name}}</span>
                <span class="lom-cat-membership-effective">{{effective}}</span>
                <span class="lom-workflow lom-workflow-{{statusclass}}">{{statuslabel}}</span>
                <span class="lom-row-actions">
                    {{#cansubmit}}<a href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
                </span>
            </div>
            {{/memberships}}
            <div class="lom-cat-actions">
                <a class="lom-page-btn" href="{{outcomesurl}}">{{#str}} catalogcourses_action_outcomes, local_outcomemap {{/str}}</a>
                <a class="lom-page-btn" href="{{instancesurl}}">{{#str}} catalogcourses_action_instances, local_outcomemap {{/str}}</a>
                {{#canedit}}<a class="lom-page-btn" href="{{editurl}}">{{#str}} catalogcourses_action_edit, local_outcomemap {{/str}}</a>{{/canedit}}
                {{#cansubmit}}<a class="lom-page-btn lom-page-btn-primary" href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
            </div>
        </div>
    </article>
    {{/rows}}

    {{#hascourses}}
    <div class="lom-page-help">{{#str}} catalogcourses_help, local_outcomemap {{/str}}</div>
    {{/hascourses}}

    {{^hascourses}}
    <div class="lom-page-empty">{{#str}} catalogcourses_empty, local_outcomemap {{/str}}</div>
    {{/hascourses}}
</div>
{{#js}}
(function() {
    var root = document.getElementById('lom-catalog');
    if (!root) {
        return;
    }
    var input = document.getElementById('lom-catalog-search');
    var noresults = document.getElementById('lom-catalog-noresults');
    var state = {filter: 'all', query: ''};

    function matchesFilter(card) {
        if (state.filter === 'noprogram') {
            return card.getAttribute('data-inprogram') === '0';
        }
        if (state.filter === 'nooutcomes') {
            return card.getAttribute('data-hasoutcomes') === '0';
        }
        return true;
    }

    function render() {
        var visible = 0;
        Array.prototype.forEach.call(root.querySelectorAll('.lom-cat-card'), function(card) {
            var querymatch = !state.query || (card.getAttribute('data-search') || '').indexOf(state.query) !== -1;
            var show = querymatch && matchesFilter(card);
            card.classList.toggle('lom-hidden', !show);
            if (show) {
                visible++;
            }
        });
        noresults.classList.toggle('lom-hidden', visible !== 0 || (state.filter === 'all' && !state.query));
        Array.prototype.forEach.call(root.querySelectorAll('.lom-filterchip[data-catalog-filter]'), function(button) {
            var active = button.getAttribute('data-catalog-filter') === state.filter;
            button.classList.toggle('lom-active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
    }

    function setOpen(card, open) {
        var chev = card.querySelector('.lom-chev');
        card.classList.toggle('lom-open', open);
        if (!chev) {
            return;
        }
        chev.innerHTML = open ? '&#9662;' : '&#9656;';
        chev.setAttribute('aria-expanded', open ? 'true' : 'false');
        var label = open ? chev.getAttribute('data-collapse-label') : chev.getAttribute('data-expand-label');
        if (label) {
            chev.setAttribute('aria-label', label);
        }
    }

    root.addEventListener('click', function(event) {
        var filterbutton = event.target.closest('button[data-catalog-filter]');
        if (filterbutton) {
            state.filter = filterbutton.getAttribute('data-catalog-filter');
            render();
            return;
        }
        // Anything actionable inside the head keeps its own behaviour; the rest of
        // the head is a large, forgiving target for expanding the card.
        var head = event.target.closest('.lom-cat-head');
        if (!head || (event.target.closest('a') && !event.target.closest('[data-lom-toggle]'))) {
            return;
        }
        var card = head.closest('.lom-cat-card');
        setOpen(card, !card.classList.contains('lom-open'));
    });
    input.addEventListener('input', function() {
        state.query = input.value.trim().toLowerCase();
        render();
    });
    // The markup ships expanded so a reader without JavaScript keeps every
    // membership and action; collapsing is this script's job.
    root.classList.add('lom-catalog-js');
    Array.prototype.forEach.call(root.querySelectorAll('.lom-cat-card'), function(card) {
        setOpen(card, false);
    });
    render();
})();
{{/js}}
