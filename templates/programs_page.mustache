{{!
    Searchable, type-grouped Programs page.
    @template local_outcomemap/programs_page
}}
<div id="lom-programs" class="lom-page lom-programs">
    <h2 class="lom-page-title">{{#str}} programs_heading, local_outcomemap {{/str}}</h2>
    <div class="lom-page-subtitle">{{#str}} programs_subtitle, local_outcomemap {{/str}}</div>

    <div class="lom-page-toolbar">
        <div class="lom-filterchips" role="group" aria-label="{{#str}} programs_filter_type, local_outcomemap {{/str}}">
            <button type="button" class="lom-filterchip lom-active" data-program-type="all" aria-pressed="true">{{#str}} all, local_outcomemap {{/str}}</button>
            <button type="button" class="lom-filterchip" data-program-type="graduate" aria-pressed="false">{{#str}} programtype_graduate, local_outcomemap {{/str}}</button>
            <button type="button" class="lom-filterchip" data-program-type="undergraduate" aria-pressed="false">{{#str}} programtype_undergraduate, local_outcomemap {{/str}}</button>
            <button type="button" class="lom-filterchip" data-program-type="specialization" aria-pressed="false">{{#str}} programtype_specialization, local_outcomemap {{/str}}</button>
        </div>
        <div class="lom-page-search">
            <span aria-hidden="true">&#128269;</span>
            <input id="lom-program-search" type="search" autocomplete="off"
                   placeholder="{{#str}} programs_searchplaceholder, local_outcomemap {{/str}}"
                   aria-label="{{#str}} programs_searchplaceholder, local_outcomemap {{/str}}">
        </div>
        {{#canmanage}}
        <a class="lom-page-btn lom-page-btn-primary lom-page-toolbar-end" href="{{addurl}}">{{#str}} addprogram, local_outcomemap {{/str}}</a>
        {{/canmanage}}
    </div>
    <div class="lom-page-stats">{{statsline}}</div>
    <div id="lom-program-noresults" class="lom-page-noresults lom-hidden">{{#str}} programs_noresults, local_outcomemap {{/str}}</div>

    {{#groups}}
    <section class="lom-section lom-program-group lom-section-type-{{typeclass}}" data-program-type="{{programtype}}">
        <div class="lom-section-head">
            <span class="lom-section-swatch" aria-hidden="true"></span>
            <span class="lom-section-title">{{title}}</span>
            <span class="lom-section-subtitle">{{description}}</span>
            <span class="lom-section-count">{{countline}}</span>
        </div>
        <div class="lom-section-body">
            {{#rows}}
            <article class="lom-program-row lom-filter-row" data-search="{{searchtext}}">
                <span class="lom-code-badge lom-code-type-{{typeclass}}">{{code}}</span>
                <span class="lom-program-summary">
                    <span class="lom-program-name">{{name}}</span>
                    <span class="lom-program-description">{{description}}</span>
                    <span class="lom-program-frameworks">{{credentiallabel}} &middot; {{frameworkcountline}}</span>
                </span>
                <span class="lom-summary-chip">{{coursecountline}}</span>
                <span class="lom-summary-chip">{{outcomecountline}}</span>
                <span class="lom-workflow lom-workflow-{{statusclass}}">{{statuslabel}}</span>
                <span class="lom-row-actions">
                    <a href="{{outcomesurl}}">{{#str}} programs_outcomes_action, local_outcomemap {{/str}}</a>
                    {{#canedit}}<a href="{{editurl}}">{{#str}} edit, core {{/str}}</a>{{/canedit}}
                    {{#cansubmit}}<a href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
                </span>
            </article>
            {{/rows}}
        </div>
    </section>
    {{/groups}}

    {{#hasprograms}}
    <div class="lom-programs-help">{{#str}} programs_specialization_help, local_outcomemap {{/str}}</div>
    {{/hasprograms}}

    {{^hasprograms}}
    <div class="lom-page-empty">{{#str}} programs_empty, local_outcomemap {{/str}}</div>
    {{/hasprograms}}
</div>
{{#js}}
(function() {
    var root = document.getElementById('lom-programs');
    if (!root) {
        return;
    }
    var input = document.getElementById('lom-program-search');
    var noresults = document.getElementById('lom-program-noresults');
    var state = {programtype: 'all', query: ''};

    function render() {
        var visible = 0;
        Array.prototype.forEach.call(root.querySelectorAll('.lom-program-group'), function(group) {
            var typematch = state.programtype === 'all' ||
                group.getAttribute('data-program-type') === state.programtype;
            var groupvisible = 0;
            Array.prototype.forEach.call(group.querySelectorAll('.lom-filter-row'), function(row) {
                var querymatch = !state.query || (row.getAttribute('data-search') || '').indexOf(state.query) !== -1;
                var show = typematch && querymatch;
                row.classList.toggle('lom-hidden', !show);
                if (show) {
                    groupvisible++;
                    visible++;
                }
            });
            group.classList.toggle('lom-hidden', groupvisible === 0);
        });
        noresults.classList.toggle('lom-hidden', visible !== 0 || (state.programtype === 'all' && !state.query));
        Array.prototype.forEach.call(root.querySelectorAll('[data-program-type]'), function(button) {
            if (button.tagName !== 'BUTTON') {
                return;
            }
            var active = button.getAttribute('data-program-type') === state.programtype;
            button.classList.toggle('lom-active', active);
            button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
    }

    root.addEventListener('click', function(event) {
        var button = event.target.closest('button[data-program-type]');
        if (!button) {
            return;
        }
        state.programtype = button.getAttribute('data-program-type');
        render();
    });
    input.addEventListener('input', function() {
        state.query = input.value.trim().toLowerCase();
        render();
    });
    render();
})();
{{/js}}
