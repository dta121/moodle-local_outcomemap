{{!
    One unit-outcome row in the outcomes hierarchy.
    @template local_outcomemap/outcomes_hierarchy_ulo
}}
<div class="lom-node lom-ulo" data-search="{{searchtext}}">
    <div class="lom-row" data-itemid="{{itemid}}" data-picker="{{pickerkey}}" data-mapped="{{mappedjson}}"
         data-statement="{{statement}}" data-editnote="{{editnote}}">
        <span class="lom-badge lom-badge-ulo">{{badge}}</span>
        <span class="lom-text" data-text="{{statement}}">{{statement}}</span>
        {{#approvedinfo}}<span class="lom-status">{{approvedinfo}}</span>{{/approvedinfo}}
        {{#pendingbadge}}<span class="lom-pending">{{pendingbadge}}</span>{{/pendingbadge}}
        {{#canapprove}}<a class="lom-action" href="{{approveurl}}">{{#str}} approve, local_outcomemap {{/str}}</a>{{/canapprove}}
        {{#cansubmit}}<a class="lom-action" href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
        {{#canmap}}<button type="button" class="lom-action lom-action-button" data-lom-map aria-expanded="false">{{#str}} hier_maplink, local_outcomemap {{/str}}</button>{{/canmap}}
        {{#caneditinline}}<button type="button" class="lom-action lom-action-button" data-lom-edit aria-expanded="false">{{#str}} edit, core {{/str}}</button>{{/caneditinline}}
        {{#editformurl}}<a class="lom-action" href="{{editformurl}}">{{#str}} edit, core {{/str}}</a>{{/editformurl}}
    </div>
    <div class="lom-inline-slot"></div>
</div>
