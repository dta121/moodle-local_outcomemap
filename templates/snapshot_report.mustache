{{!
    One accreditation snapshot presented as a readable evidence report.
    @template local_outcomemap/snapshot_report

    Context variables required for this template:
    * programcode, programname, versionline string Snapshot identity.
    * isfrozen boolean Whether the snapshot is frozen and immutable.
    * statuslabel string Integrity/state badge text.
    * facts array Four headline facts, each with label, value, note.
    * progress object Cohort course-progress tiles, the criterion used, and the population line.
    * controls object Grouping links, subject-filter chips, and the filtered-view note.
    * outcomes array Groups, each with framework (group label), countline, rows.
      Each row carries band (met/near/below) and contributions: the courses behind its rate.
    * hascriterion boolean Whether a criterion was in force, so bands can be read.
    * hasoutcomes boolean Whether any program-scope aggregate was captured.
    * totals object Aggregate learners, results, percent, frameworkcount.
    * courses array Course evidence rows.
    * methods array Method cards, each with label and value.
    * provenance array Label/value/mono rows.
    * rowtypes array Captured row counts by object type.
    * rowsline string Total captured and suppressed rows.
    * exports object Export availability and URLs.
    * backurl, canfreeze, freezeurl, cancorrect, correcturl, candelete, deleteurl Navigation and actions.

    Example context (json):
    {
        "programcode": "MBA",
        "programname": "Master of Business Administration",
        "versionline": "Version 1 · frozen 27 July 2026 · reporting period MBA601",
        "isfrozen": true,
        "statuslabel": "Frozen & integrity verified",
        "facts": [{"label": "Population size", "value": "133 learners", "note": "Active enrolled users"}],
        "progress": {
            "known": true,
            "populationline": "133 subjects in the population (active enrolled at data freeze)",
            "criterion": "A course counts as passed at 80.0% or above",
            "tiles": [{"label": "Passing every course so far", "value": "104", "note": "78.2% of the population", "variant": "lom-snap-progress-good"}]
        },
        "controls": {
            "groupings": [{"label": "Unit outcome", "url": "#", "active": true}],
            "groupsub": "Every captured outcome, grouped by its own framework.",
            "filters": [{"label": "All subjects", "count": "133", "url": "#", "active": true}],
            "filtered": false,
            "filternote": "",
            "liverollup": false,
            "liverollupnote": ""
        },
        "outcomes": [{
            "framework": "MBA-PLO",
            "countline": "2 outcomes reported",
            "rows": [{
                "code": "PLO1", "statement": "Analyse financial statements.",
                "evidence": ["MBA601"], "hasevidence": true, "suppressed": false,
                "learners": "128", "results": "868", "percent": "87.5%", "barwidth": 87.5, "hasbar": true,
                "band": "met", "hascontributions": true, "contributionline": "2 contributing courses",
                "haswithheld": false, "withheldline": "0 withheld",
                "contributions": [{
                    "code": "MBA601", "name": "Financial Management", "suppressed": false,
                    "hasrate": true, "rate": "87.5%", "barwidth": 87.5, "band": "met",
                    "learners": "128", "pooled": "pooled 84.2%"
                }]
            }]
        }],
        "hasoutcomes": true,
        "hascriterion": true,
        "totals": {"learners": "133", "results": "1,484", "percent": "82.1%", "frameworkcount": 3},
        "courses": [{
            "code": "MBA601", "name": "Financial Management",
            "shell": "MBA601: Financial Management · period MBA601",
            "outcomes": "8 outcomes reported", "learners": "133 learners", "results": "868 results"
        }],
        "methods": [{"label": "Small-cell suppression", "value": "Figures from fewer than 5 learners are withheld."}],
        "provenance": [{"label": "Snapshot UUID", "value": "c1b5a6f9", "mono": true}],
        "rowtypes": [{"type": "evidence", "count": "27,100", "suppressed": 0}],
        "rowsline": "29,220 rows captured · 0 suppressed · threshold 5",
        "exports": {"canexport": true, "csvurl": "#", "jsonurl": "#", "canevidence": false, "notfrozen": false},
        "backurl": "#", "canfreeze": false, "freezeurl": "#", "cancorrect": true, "correcturl": "#",
        "candelete": true, "deleteurl": "#"
    }
}}
<div id="lom-snapreport" class="lom-page lom-snapreport">
    <h2 class="lom-page-title">{{#str}} snapreport_heading, local_outcomemap {{/str}}</h2>
    <div class="lom-page-subtitle">{{#str}} snapreport_subtitle, local_outcomemap {{/str}}</div>

    <section class="lom-snap-identity">
        <div class="lom-snap-identity-head">
            <div class="lom-snap-identity-main">
                <div class="lom-snap-eyebrow">{{#str}} snapreport_eyebrow, local_outcomemap {{/str}}</div>
                <div class="lom-snap-program">{{programcode}} &mdash; {{programname}}</div>
                <div class="lom-snap-versionline">{{versionline}}</div>
            </div>
            <span class="lom-snap-state {{#isfrozen}}lom-snap-state-frozen{{/isfrozen}}{{^isfrozen}}lom-snap-state-draft{{/isfrozen}}">{{statuslabel}}</span>
        </div>
        <div class="lom-snap-facts">
            {{#facts}}
            <div class="lom-snap-fact">
                <div class="lom-snap-fact-label">{{label}}</div>
                <div class="lom-snap-fact-value">{{value}}</div>
                <div class="lom-snap-fact-note">{{note}}</div>
            </div>
            {{/facts}}
        </div>
    </section>

    <h3 class="lom-snap-section-title">{{#str}} snapreport_progress_heading, local_outcomemap {{/str}}</h3>
    <div class="lom-snap-section-sub">{{#str}} snapreport_progress_sub, local_outcomemap {{/str}}</div>
    {{#progress.known}}
    <div class="lom-snap-progressline">{{progress.populationline}} &middot; {{progress.criterion}}</div>
    <div class="lom-snap-progress">
        {{#progress.tiles}}
        <div class="lom-snap-progresstile {{variant}}">
            <div class="lom-snap-progress-label">{{label}}</div>
            <div class="lom-snap-progress-value">{{value}}</div>
            <div class="lom-snap-progress-note">{{note}}</div>
        </div>
        {{/progress.tiles}}
    </div>
    {{/progress.known}}
    {{^progress.known}}
    <div class="lom-page-empty">{{#str}} snapreport_progress_nocriterion, local_outcomemap {{/str}}</div>
    {{/progress.known}}

    <h3 class="lom-snap-section-title">{{#str}} snapreport_attainment_heading, local_outcomemap {{/str}}</h3>
    <div class="lom-snap-section-sub">{{#str}} snapreport_attainment_sub, local_outcomemap {{/str}}</div>
    <div class="lom-snap-controls">
        <span class="lom-snap-controls-label">{{#str}} snapreport_groupby, local_outcomemap {{/str}}</span>
        <span class="lom-snap-modes">
            {{#controls.groupings}}
            <a class="lom-snap-modebtn {{#active}}lom-snap-modebtn-active{{/active}}" href="{{url}}"
               {{#active}}aria-current="true"{{/active}}>{{label}}</a>
            {{/controls.groupings}}
        </span>
        <span class="lom-snap-controls-sub">{{controls.groupsub}}</span>
    </div>
    <div class="lom-snap-controls">
        <span class="lom-snap-controls-label">{{#str}} snapreport_subjectsby, local_outcomemap {{/str}}</span>
        <span class="lom-snap-chips">
            {{#controls.filters}}
            <a class="lom-snap-chip {{#active}}lom-snap-chip-active{{/active}}" href="{{url}}"
               {{#active}}aria-current="true"{{/active}}>{{label}} <span class="lom-snap-chip-count">{{count}}</span></a>
            {{/controls.filters}}
        </span>
    </div>
    {{#controls.liverollup}}
    <div class="lom-snap-filternote">{{controls.liverollupnote}}</div>
    {{/controls.liverollup}}
    {{#controls.filtered}}
    <div class="lom-snap-filternote">{{controls.filternote}}</div>
    {{/controls.filtered}}
    {{#hasoutcomes}}
    <div class="lom-snap-table">
        <div class="lom-snap-row lom-snap-head">
            <span>{{#str}} snapreport_col_outcome, local_outcomemap {{/str}}</span>
            <span>{{#str}} snapreport_col_statement, local_outcomemap {{/str}}</span>
            <span class="lom-snap-num">{{#str}} snapreport_col_learners, local_outcomemap {{/str}}</span>
            <span class="lom-snap-num">{{#str}} snapreport_col_results, local_outcomemap {{/str}}</span>
            <span>{{#str}} snapreport_col_attainment, local_outcomemap {{/str}}</span>
            <span>{{#str}} snapreport_col_rate, local_outcomemap {{/str}}</span>
        </div>
        {{#outcomes}}
        <div class="lom-snap-fwrow">
            <span class="lom-snap-fwcode">{{framework}}</span>
            <span class="lom-snap-fwcount">{{countline}}</span>
        </div>
        {{#rows}}
        <div class="lom-snap-row">
            <span class="lom-code-badge lom-code-catalog lom-snap-code">{{code}}</span>
            <div class="lom-snap-statement">
                <span class="lom-snap-statement-text">{{statement}}</span>
                {{#hascontributions}}
                <details class="lom-snap-contrib">
                    <summary class="lom-snap-contrib-summary">
                        <span class="lom-snap-contrib-count">{{contributionline}}</span>
                        {{#haswithheld}}<span class="lom-snap-contrib-withheld">{{withheldline}}</span>{{/haswithheld}}
                    </summary>
                    <span class="lom-snap-contrib-list">
                        {{#contributions}}
                        <span class="lom-snap-contrib-row">
                            <span class="lom-code-badge lom-code-catalog lom-snap-contrib-code">{{code}}</span>
                            <span class="lom-snap-contrib-name">{{name}}</span>
                            {{#hasrate}}
                            <span class="lom-snap-contrib-bar">
                                <span class="lom-snap-bar-fill lom-snap-band-{{band}}" style="width: {{barwidth}}%"></span>
                            </span>
                            <span class="lom-snap-contrib-rate lom-snap-band-{{band}}">{{rate}}</span>
                            <span class="lom-snap-contrib-note">{{learners}} &middot; {{pooled}}</span>
                            {{/hasrate}}
                            {{^hasrate}}
                            <span class="lom-snap-contrib-bar"></span>
                            <span class="lom-snap-contrib-rate lom-snap-withheld">&mdash;</span>
                            <span class="lom-snap-contrib-note">
                                {{#suppressed}}{{#str}} snapreport_contribution_suppressed, local_outcomemap {{/str}}{{/suppressed}}
                                {{^suppressed}}{{rate}}{{/suppressed}}
                            </span>
                            {{/hasrate}}
                        </span>
                        {{/contributions}}
                    </span>
                </details>
                {{/hascontributions}}
            </div>
            {{^suppressed}}
            <span class="lom-snap-num">{{learners}}</span>
            <span class="lom-snap-num">{{results}}</span>
            <span class="lom-snap-attain">
                {{#hasbar}}<span class="lom-snap-bar"><span class="lom-snap-bar-fill" style="width: {{barwidth}}%"></span></span>{{/hasbar}}
                <span class="lom-snap-pct">{{percent}}</span>
            </span>
            <span class="lom-snap-rate" title="{{ratedetail}}">
                <span class="lom-snap-pct lom-snap-band-{{band}}">{{rate}}</span>
                {{#hasbenchmark}}
                <span class="lom-snap-benchmark">{{benchmark}}</span>
                {{/hasbenchmark}}
                {{#benchmarkmet}}<span class="lom-workflow lom-workflow-approved">{{benchmarklabel}}</span>{{/benchmarkmet}}
                {{#benchmarkmissed}}<span class="lom-workflow lom-workflow-draft">{{benchmarklabel}}</span>{{/benchmarkmissed}}
            </span>
            {{/suppressed}}
            {{#suppressed}}
            <span class="lom-snap-num lom-snap-withheld">&mdash;</span>
            <span class="lom-snap-num lom-snap-withheld">&mdash;</span>
            <span class="lom-workflow lom-workflow-review">{{#str}} exportsuppressed, local_outcomemap {{/str}}</span>
            <span class="lom-snap-num lom-snap-withheld">&mdash;</span>
            {{/suppressed}}
        </div>
        {{/rows}}
        {{/outcomes}}
        <div class="lom-snap-row lom-snap-total">
            <span></span>
            <span class="lom-snap-total-label">{{#str}} snapreport_programaggregate, local_outcomemap {{/str}}</span>
            <span class="lom-snap-num">{{totals.learners}}</span>
            <span class="lom-snap-num">{{totals.results}}</span>
            <span class="lom-snap-attain"><span class="lom-snap-pct">{{totals.percent}}</span></span>
            <span class="lom-snap-rate">
                {{#totals.hasbenchmarks}}<span class="lom-snap-benchmark">{{totals.benchmarksummary}}</span>{{/totals.hasbenchmarks}}
            </span>
        </div>
    </div>
    {{#hascriterion}}
    <div class="lom-snap-legend">
        <span class="lom-snap-legend-key"><i class="lom-snap-swatch lom-snap-band-met"></i>{{#str}} snapreport_band_met, local_outcomemap {{/str}}</span>
        <span class="lom-snap-legend-key"><i class="lom-snap-swatch lom-snap-band-near"></i>{{#str}} snapreport_band_near, local_outcomemap {{/str}}</span>
        <span class="lom-snap-legend-key"><i class="lom-snap-swatch lom-snap-band-below"></i>{{#str}} snapreport_band_below, local_outcomemap {{/str}}</span>
        <span class="lom-snap-legend-note">{{rowsline}}</span>
    </div>
    {{/hascriterion}}
    {{/hasoutcomes}}
    {{^hasoutcomes}}
    <div class="lom-page-empty">{{#str}} snapreport_nooutcomes, local_outcomemap {{/str}}</div>
    {{/hasoutcomes}}

    <h3 class="lom-snap-section-title">{{#str}} snapreport_courses_heading, local_outcomemap {{/str}}</h3>
    <div class="lom-snap-section-sub">{{#str}} snapreport_courses_sub, local_outcomemap {{/str}}</div>
    <div class="lom-snap-table">
        {{#courses}}
        <div class="lom-snap-courserow">
            <span class="lom-code-badge lom-code-catalog lom-snap-code">{{code}}</span>
            <span class="lom-snap-coursemain">
                <span class="lom-snap-coursename">{{name}}</span>
                <span class="lom-snap-courseshell">{{shell}}</span>
            </span>
            <span class="lom-snap-coursefact">{{outcomes}}</span>
            <span class="lom-snap-coursefact">{{learners}}</span>
            <span class="lom-snap-coursefact">{{results}}</span>
            {{#haspass}}
            <span class="lom-snap-coursepass" title="{{passline}}">
                <span class="lom-snap-coursepct">{{passrate}}</span>
                <span class="lom-snap-coursepassnote">{{passline}}</span>
            </span>
            {{/haspass}}
            {{^haspass}}
            <span class="lom-snap-coursefact lom-snap-withheld">&mdash;</span>
            {{/haspass}}
        </div>
        {{/courses}}
    </div>

    <h3 class="lom-snap-section-title">{{#str}} snapreport_method_heading, local_outcomemap {{/str}}</h3>
    <div class="lom-snap-section-sub">{{#str}} snapreport_method_sub, local_outcomemap {{/str}}</div>
    <div class="lom-snap-methods">
        {{#methods}}
        <div class="lom-snap-method">
            <div class="lom-snap-method-label">{{label}}</div>
            <div class="lom-snap-method-value">{{value}}</div>
        </div>
        {{/methods}}
    </div>

    <div class="lom-section lom-snap-prov">
        <button type="button" class="lom-snap-prov-head" data-lom-toggle aria-expanded="false"
                aria-controls="lom-snap-prov-body"
                data-expand-label="{{#str}} expand, core {{/str}}"
                data-collapse-label="{{#str}} collapse, core {{/str}}">
            <span class="lom-chev" aria-hidden="true">&#9656;</span>
            <span class="lom-snap-prov-title">{{#str}} snapreport_provenance_heading, local_outcomemap {{/str}}</span>
            <span class="lom-snap-prov-sub">{{#str}} snapreport_provenance_sub, local_outcomemap {{/str}}</span>
        </button>
        <div class="lom-snap-prov-body" id="lom-snap-prov-body">
            <dl class="lom-snap-provgrid">
                {{#provenance}}
                <dt>{{label}}</dt>
                <dd class="{{#mono}}lom-snap-mono{{/mono}}">{{value}}</dd>
                {{/provenance}}
            </dl>
            <div class="lom-snap-prov-label">{{#str}} snapreport_capturedrows, local_outcomemap {{/str}}</div>
            <div class="lom-snap-rowchips">
                {{#rowtypes}}
                <span class="lom-snap-rowchip">{{type}} <b>{{count}}</b></span>
                {{/rowtypes}}
            </div>
            <div class="lom-snap-rowsline">{{rowsline}}</div>
        </div>
    </div>

    <div class="lom-snap-actions">
        {{#exports.canexport}}
        <a class="lom-page-btn lom-page-btn-primary" href="{{exports.jsonurl}}">{{#str}} exportpackagejson, local_outcomemap {{/str}}</a>
        <a class="lom-page-btn" href="{{exports.csvurl}}">{{#str}} exportsummarycsv, local_outcomemap {{/str}}</a>
        {{#exports.canevidence}}
        <a class="lom-page-btn" href="{{exports.evidenceurl}}">{{#str}} exportevidencedetail, local_outcomemap {{/str}}</a>
        {{/exports.canevidence}}
        {{/exports.canexport}}
        {{#canfreeze}}
        <a class="lom-page-btn lom-page-btn-primary" href="{{freezeurl}}">{{#str}} freezesnapshot, local_outcomemap {{/str}}</a>
        {{/canfreeze}}
        {{#cancorrect}}
        <a class="lom-page-btn" href="{{correcturl}}">{{#str}} correctsnapshot, local_outcomemap {{/str}}</a>
        {{/cancorrect}}
        {{#candelete}}
        <a class="lom-page-btn lom-page-btn-danger" href="{{deleteurl}}">{{#str}} deletesnapshot, local_outcomemap {{/str}}</a>
        {{/candelete}}
        <a class="lom-page-btn" href="{{backurl}}">{{#str}} back, core {{/str}}</a>
    </div>
    {{#exports.notfrozen}}
    <div class="lom-page-help">{{#str}} exportnotfrozen, local_outcomemap {{/str}}</div>
    {{/exports.notfrozen}}
</div>
{{#js}}
(function() {
    var root = document.getElementById('lom-snapreport');
    if (!root) {
        return;
    }
    var trigger = root.querySelector('.lom-snap-prov-head');
    var panel = document.getElementById('lom-snap-prov-body');
    if (!trigger || !panel) {
        return;
    }
    function setOpen(open) {
        root.classList.toggle('lom-snap-prov-open', open);
        trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
        var chev = trigger.querySelector('.lom-chev');
        if (chev) {
            chev.innerHTML = open ? '&#9662;' : '&#9656;';
        }
        var label = open ? trigger.getAttribute('data-collapse-label') : trigger.getAttribute('data-expand-label');
        if (label) {
            trigger.setAttribute('title', label);
        }
    }
    trigger.addEventListener('click', function() {
        setOpen(!root.classList.contains('lom-snap-prov-open'));
    });
    // The record ships expanded so it stays readable without JavaScript; this
    // script collapses it and takes over the disclosure.
    root.classList.add('lom-snapreport-js');
    setOpen(false);
})();
{{/js}}
