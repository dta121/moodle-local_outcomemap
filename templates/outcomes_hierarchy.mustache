{{!
    Frameworks and outcomes hierarchy page.
    @template local_outcomemap/outcomes_hierarchy

    Example context (json):
    {
        "frameworksline": "2 frameworks",
        "viewtabs": [
            {"isbutton": true, "active": true, "id": "program", "label": "By program"}
        ],
        "statsline": "8 approved outcomes",
        "hierarchyline": "Program, course, and unit outcomes",
        "exporturl": "/local/outcomemap/export.php",
        "alignmentexporturl": "/local/outcomemap/export.php?type=alignments",
        "canmanage": false,
        "ismatrix": false,
        "hasunmapped": false,
        "programcards": [],
        "coursecards": []
    }
}}
<div id="lom-hier" class="lom-hier" data-lockedmsg="{{#str}} hier_alreadymapped, local_outcomemap {{/str}}">
    <h2 class="lom-title">{{#str}} outcomes_heading, local_outcomemap {{/str}}</h2>
    <div class="lom-subtitle">{{frameworksline}}</div>

    <div class="lom-toolbar">
        <div class="lom-viewtoggle" role="group" aria-label="{{#str}} outcomes_view, local_outcomemap {{/str}}">
            {{#viewtabs}}
            {{#isbutton}}<button type="button" class="lom-viewbtn {{#active}}lom-active{{/active}}" data-lom-view="{{id}}" aria-pressed="{{#active}}true{{/active}}{{^active}}false{{/active}}">{{label}}</button>{{/isbutton}}
            {{#islink}}<a class="lom-viewbtn {{#active}}lom-active{{/active}}" href="{{url}}" {{#active}}aria-current="page"{{/active}}>{{label}}</a>{{/islink}}
            {{/viewtabs}}
        </div>
        <div class="lom-search">
            <span class="lom-search-icon" aria-hidden="true">&#128269;</span>
            <input id="lom-search" type="text" autocomplete="off"
                   placeholder="{{#str}} hier_searchplaceholder, local_outcomemap {{/str}}"
                   aria-label="{{#str}} hier_searchplaceholder, local_outcomemap {{/str}}">
            <button type="button" id="lom-clear" class="lom-clear lom-hidden" aria-label="{{#str}} clear, core {{/str}}">&times;</button>
        </div>
        {{#hasunmapped}}
        <button type="button" id="lom-chip" class="lom-chipbtn" aria-pressed="false">{{#str}} hier_unmappedchip, local_outcomemap, {{unmappedcount}} {{/str}}</button>
        {{/hasunmapped}}
        <div class="lom-toolbar-right">
            <a class="lom-btn" href="{{exporturl}}">{{#str}} outcomes_exportoutcomes, local_outcomemap {{/str}}</a>
            <a class="lom-btn" href="{{alignmentexporturl}}">{{#str}} outcomes_exportalignments, local_outcomemap {{/str}}</a>
            {{#canmanage}}
            {{#ismatrix}}<a class="lom-btn" href="{{addalignmenturl}}">{{#str}} addrelation, local_outcomemap {{/str}}</a>{{/ismatrix}}
            <a class="lom-btn" href="{{addframeworkurl}}">{{#str}} addframework, local_outcomemap {{/str}}</a>
            <a class="lom-btn lom-btn-primary" href="{{addoutcomeurl}}">{{#str}} addoutcome, local_outcomemap {{/str}}</a>
            {{/canmanage}}
        </div>
    </div>
    <div class="lom-stats">{{statsline}} &mdash; {{hierarchyline}}</div>

    {{#hasunmapped}}
    <div id="lom-callout" class="lom-callout">
        <span class="lom-callout-count">{{unmappedcount}}</span>
        <span class="lom-callout-text">{{calloutmessage}}</span>
        <button type="button" class="lom-btn lom-btn-warn" data-lom-review>{{#str}} hier_reviewunmapped, local_outcomemap {{/str}}</button>
    </div>
    {{/hasunmapped}}

    <div id="lom-noresults" class="lom-noresults lom-hidden" role="status" aria-live="polite">{{#str}} hier_noresults, local_outcomemap {{/str}}</div>

    {{#ismatrix}}
    <div id="lom-view-matrix">
        {{#alignment}}
        {{#groups}}
        <section class="lom-section lom-filter-row" data-search="{{searchtext}}">
            <div class="lom-section-head">
                <h3 class="lom-section-title">{{title}}</h3>
                <span class="lom-section-subtitle">{{subtitle}}</span>
                <span class="lom-section-count">{{countline}}</span>
            </div>
            {{#hasmatrix}}
            <div class="lom-matrix-wrap">
                <table class="lom-matrix">
                    <caption class="visually-hidden">{{title}} &mdash; {{subtitle}}</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="lom-matrix-source">{{#str}} sourceoutcome, local_outcomemap {{/str}}</th>
                            {{#columns}}
                            <th scope="col">
                                <span class="lom-matrix-column-code">{{code}}</span>
                                <span class="lom-matrix-column-statement">{{statement}}</span>
                            </th>
                            {{/columns}}
                        </tr>
                    </thead>
                    <tbody>
                        {{#matrixrows}}
                        <tr class="lom-filter-row" data-search="{{searchtext}}">
                            <th scope="row" class="lom-matrix-source" title="{{code}} &mdash; {{statement}}"><strong>{{code}}</strong><span>{{statement}}</span></th>
                            {{#cells}}
                            <td title="{{title}}">
                                {{#hasrelation}}
                                    {{#hasaction}}<a class="lom-matrix-cell" href="{{actionurl}}"><span class="lom-matrix-dot lom-dot-{{statusclass}}"></span><span class="visually-hidden">{{title}}</span></a>{{/hasaction}}
                                    {{^hasaction}}<span class="lom-matrix-cell"><span class="lom-matrix-dot lom-dot-{{statusclass}}"></span><span class="visually-hidden">{{title}}</span></span>{{/hasaction}}
                                {{/hasrelation}}
                                {{^hasrelation}}
                                    {{#canadd}}<a class="lom-matrix-cell lom-matrix-empty" href="{{addurl}}"><span aria-hidden="true">+</span><span class="visually-hidden">{{title}}</span></a>{{/canadd}}
                                    {{^canadd}}<span class="lom-matrix-cell lom-matrix-empty"><span class="visually-hidden">{{title}}</span></span>{{/canadd}}
                                {{/hasrelation}}
                            </td>
                            {{/cells}}
                        </tr>
                        {{/matrixrows}}
                    </tbody>
                </table>
            </div>
            <div class="lom-matrix-help">{{#str}} relations_matrix_help, local_outcomemap {{/str}}</div>
            {{/hasmatrix}}
            {{^hasmatrix}}
            <div class="lom-matrix-empty-section">{{#str}} outcomes_matrix_nogrid, local_outcomemap {{/str}}</div>
            {{/hasmatrix}}
        </section>
        {{/groups}}
        {{^hasrelations}}
        <div class="lom-page-empty">{{#str}} relations_empty, local_outcomemap {{/str}}</div>
        {{/hasrelations}}
        {{/alignment}}
    </div>
    {{/ismatrix}}

    {{^ismatrix}}
    <div id="lom-view-unmapped" class="lom-hidden">
        <div class="lom-card lom-card-warn">
            <div class="lom-warnhead">
                <span class="lom-warnhead-title">{{#str}} hier_unmappedtitle, local_outcomemap {{/str}}</span>
                <span class="lom-warnhead-sub">{{#str}} hier_unmappedsubtitle, local_outcomemap {{/str}}</span>
                <button type="button" class="lom-linkbtn" data-lom-backfull>{{#str}} hier_backtofull, local_outcomemap {{/str}}</button>
            </div>
            {{#unmappedgroups}}
            <div class="lom-group">
                <div class="lom-group-label lom-group-label-flat">{{label}}</div>
                {{#rows}}{{> local_outcomemap/outcomes_hierarchy_ulo }}{{/rows}}
            </div>
            {{/unmappedgroups}}
            {{^unmappedgroups}}<div class="lom-empty lom-empty-plain">{{#str}} hier_nonemapped, local_outcomemap {{/str}}</div>{{/unmappedgroups}}
        </div>
    </div>

    <div id="lom-view-program">
        {{#programcards}}
        <div class="lom-card lom-node lom-open" data-search="{{searchtext}}">
            <div class="lom-card-head">
                <span class="lom-card-title">{{title}}</span>
                <span class="lom-card-sub">{{subtitle}}</span>
                <span class="lom-card-count">{{countline}}</span>
            </div>
            {{#frameworks}}
            <div class="lom-fwbar">
                <span class="lom-fwbar-code">{{code}}</span>
                <span class="lom-fwbar-name">{{name}}</span>
                <span class="lom-fwbar-status">{{statuslabel}}</span>
                <span class="lom-fwbar-actions">
                    {{#canedit}}<a href="{{editurl}}">{{editlabel}}</a>{{/canedit}}
                    {{#cansubmit}}<a href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
                    {{#locked}}<span class="lom-fwbar-locked">{{lockedreason}}</span>{{/locked}}
                </span>
            </div>
            {{/frameworks}}
            <div class="lom-children">
                {{#rows}}
                <div class="lom-node lom-plo" data-search="{{searchtext}}">
                    <div class="lom-row lom-row-toggle" data-itemid="{{itemid}}" data-statement="{{statement}}"
                         data-editnote="{{editnote}}">
                        <button type="button" class="lom-chev" data-lom-toggle aria-expanded="false"
                                data-expand-label="{{#str}} expand, core {{/str}}"
                                data-collapse-label="{{#str}} collapse, core {{/str}}"
                                aria-label="{{#str}} expand, core {{/str}}">&#9656;</button>
                        <span class="lom-badge lom-badge-plo">{{badge}}</span>
                        <span class="lom-text lom-text-plo" data-text="{{statement}}">{{statement}}</span>
                        <span class="lom-count">{{countchip}}</span>
                        {{#approvedinfo}}<span class="lom-status">{{approvedinfo}}</span>{{/approvedinfo}}
                        {{#pendingbadge}}<span class="lom-pending">{{pendingbadge}}</span>{{/pendingbadge}}
                        {{#canapprove}}<a class="lom-action" href="{{approveurl}}">{{#str}} approve, local_outcomemap {{/str}}</a>{{/canapprove}}
                        {{#cansubmit}}<a class="lom-action" href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
                        {{#caneditinline}}<button type="button" class="lom-action lom-action-button" data-lom-edit aria-expanded="false">{{#str}} edit, core {{/str}}</button>{{/caneditinline}}
                        {{#editformurl}}<a class="lom-action" href="{{editformurl}}">{{#str}} edit, core {{/str}}</a>{{/editformurl}}
                    </div>
                    <div class="lom-inline-slot"></div>
                    <div class="lom-children lom-children-plo">
                        {{#groups}}
                        <div class="lom-group">
                            <div class="lom-group-label">{{label}}</div>
                            <div class="lom-group-body">
                                {{#clos}}{{> local_outcomemap/outcomes_hierarchy_clo }}{{/clos}}
                            </div>
                        </div>
                        {{/groups}}
                        {{#nogroups}}<div class="lom-empty lom-empty-plain">{{#str}} hier_noclos, local_outcomemap {{/str}}</div>{{/nogroups}}
                    </div>
                </div>
                {{/rows}}
            </div>
        </div>
        {{/programcards}}
    </div>

    <div id="lom-view-course" class="lom-hidden">
        {{#coursecards}}
        <div class="lom-card lom-node lom-open" data-search="{{searchtext}}">
            <div class="lom-card-head lom-row-toggle">
                <button type="button" class="lom-chev" data-lom-toggle aria-expanded="true"
                        data-expand-label="{{#str}} expand, core {{/str}}"
                        data-collapse-label="{{#str}} collapse, core {{/str}}"
                        aria-label="{{#str}} collapse, core {{/str}}">&#9662;</button>
                <span class="lom-card-title">{{course}}</span>
                <span class="lom-card-sub">{{subtitle}}</span>
                <span class="lom-card-count">{{countline}}</span>
            </div>
            {{#frameworks}}
            <div class="lom-fwbar">
                <span class="lom-fwbar-code">{{code}}</span>
                <span class="lom-fwbar-name">{{name}}</span>
                <span class="lom-fwbar-status">{{statuslabel}}</span>
                <span class="lom-fwbar-actions">
                    {{#canedit}}<a href="{{editurl}}">{{editlabel}}</a>{{/canedit}}
                    {{#cansubmit}}<a href="{{submiturl}}">{{submitlabel}}</a>{{/cansubmit}}
                    {{#locked}}<span class="lom-fwbar-locked">{{lockedreason}}</span>{{/locked}}
                </span>
            </div>
            {{/frameworks}}
            <div class="lom-children">
                {{#clos}}{{> local_outcomemap/outcomes_hierarchy_clo }}{{/clos}}
                {{#hasunmappedulos}}
                <div class="lom-node lom-unmapped-section" data-search="">
                    <div class="lom-row lom-row-toggle lom-unmapped-head">
                        <button type="button" class="lom-chev" data-lom-toggle aria-expanded="false"
                                data-expand-label="{{#str}} expand, core {{/str}}"
                                data-collapse-label="{{#str}} collapse, core {{/str}}"
                                aria-label="{{#str}} expand, core {{/str}}">&#9656;</button>
                        <span class="lom-unmapped-title">{{#str}} hier_unmappedunit_header, local_outcomemap {{/str}}</span>
                        <span class="lom-unmapped-count">{{unmappedcount}}</span>
                        <span class="lom-unmapped-sub">{{#str}} hier_notaligned, local_outcomemap {{/str}}</span>
                    </div>
                    <div class="lom-inline-slot"></div>
                    <div class="lom-children">
                        {{#unmappedulos}}{{> local_outcomemap/outcomes_hierarchy_ulo }}{{/unmappedulos}}
                    </div>
                </div>
                {{/hasunmappedulos}}
            </div>
        </div>
        {{/coursecards}}
    </div>

    {{/ismatrix}}

    {{#pickers}}
    <template id="lom-picker-{{key}}">
        <form method="post" action="{{baseurl}}" class="lom-panel">
            <fieldset class="lom-panel-fieldset">
                <legend class="lom-panel-title">{{title}}</legend>
                <input type="hidden" name="action" value="savemap">
                <input type="hidden" name="sesskey" value="{{sesskey}}">
                <input type="hidden" name="itemid" value="">
                <div class="lom-picker-opts">
                    {{#options}}
                    <label class="lom-opt">
                        <input type="checkbox" name="targets[]" value="{{itemid}}">
                        <span><strong>{{label}}</strong> &mdash; {{text}}</span>
                    </label>
                    {{/options}}
                </div>
                <div class="lom-panel-actions">
                    <button type="submit" class="lom-btn lom-btn-primary">{{#str}} hier_done, local_outcomemap {{/str}}</button>
                    <button type="button" class="lom-btn" data-lom-close>{{#str}} cancel, core {{/str}}</button>
                </div>
            </fieldset>
        </form>
    </template>
    {{/pickers}}

    <template id="lom-edit-template">
        <form method="post" action="{{baseurl}}" class="lom-panel">
            <input type="hidden" name="action" value="savenewversion">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="itemid" value="">
            <label class="lom-edit-label" for="lom-edit-statement">{{#str}} statement, local_outcomemap {{/str}}</label>
            <input id="lom-edit-statement" type="text" name="statement" class="lom-edit-input" maxlength="1333" required>
            <div class="lom-panel-actions">
                <button type="submit" class="lom-btn lom-btn-primary">{{#str}} hier_savenewversion, local_outcomemap {{/str}}</button>
                <button type="button" class="lom-btn" data-lom-close>{{#str}} cancel, core {{/str}}</button>
                <span class="lom-note" data-lom-editnote></span>
            </div>
        </form>
    </template>
</div>
{{#js}}
(function() {
    var root = document.getElementById('lom-hier');
    if (!root) {
        return;
    }
    var state = {view: '{{initialview}}', unmappedOnly: false, q: ''};
    var views = {
        program: document.getElementById('lom-view-program'),
        course: document.getElementById('lom-view-course'),
        unmapped: document.getElementById('lom-view-unmapped')
    };
    var searchInput = document.getElementById('lom-search');
    var clearBtn = document.getElementById('lom-clear');
    var chip = document.getElementById('lom-chip');
    var callout = document.getElementById('lom-callout');
    var noresults = document.getElementById('lom-noresults');
    var activePanelTrigger = null;

    // The alignment matrix is its own render and carries none of the hierarchy
    // views, so the search box is the only control that applies to it.
    var matrix = document.getElementById('lom-view-matrix');
    if (matrix) {
        var filterMatrix = function() {
            var q = searchInput.value.trim().toLowerCase();
            var any = false;
            Array.prototype.forEach.call(matrix.querySelectorAll('.lom-filter-row'), function(row) {
                var show = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
                row.classList.toggle('lom-hidden', !show);
                if (show && row.tagName === 'SECTION') {
                    any = true;
                }
            });
            // A section whose rows all fell away still matches on its own heading,
            // so emptiness is judged on the sections rather than the rows.
            noresults.classList.toggle('lom-hidden', !q || any);
            clearBtn.classList.toggle('lom-hidden', !q);
        };
        searchInput.addEventListener('input', filterMatrix);
        clearBtn.addEventListener('click', function() {
            searchInput.value = '';
            filterMatrix();
            searchInput.focus();
        });
        filterMatrix();
        return;
    }

    function closePanels(restoreFocus) {
        var trigger = activePanelTrigger;
        Array.prototype.forEach.call(root.querySelectorAll('.lom-inline-slot'), function(slot) {
            slot.innerHTML = '';
            slot.removeAttribute('data-panel');
        });
        if (trigger) {
            trigger.setAttribute('aria-expanded', 'false');
            trigger.removeAttribute('aria-controls');
        }
        activePanelTrigger = null;
        if (restoreFocus && trigger && document.contains(trigger)) {
            trigger.focus();
        }
    }

    function syncChevrons() {
        Array.prototype.forEach.call(root.querySelectorAll('.lom-node'), function(n) {
            var chev = n.querySelector(':scope > .lom-row .lom-chev, :scope > .lom-card-head .lom-chev');
            if (!chev) {
                return;
            }
            var open = n.classList.contains('lom-open') || n.classList.contains('lom-open-search');
            chev.innerHTML = open ? '&#9662;' : '&#9656;';
            chev.setAttribute('aria-expanded', open ? 'true' : 'false');
            var label = open ? chev.getAttribute('data-collapse-label') : chev.getAttribute('data-expand-label');
            if (label) {
                chev.setAttribute('aria-label', label);
            }
        });
    }

    function applyHighlight(q) {
        Array.prototype.forEach.call(root.querySelectorAll('.lom-text'), function(el) {
            var orig = el.getAttribute('data-text') || '';
            if (!q) {
                el.textContent = orig;
                return;
            }
            var lower = orig.toLowerCase();
            var frag = document.createDocumentFragment();
            var i = 0;
            var idx = lower.indexOf(q);
            while (idx !== -1) {
                if (idx > i) {
                    frag.appendChild(document.createTextNode(orig.slice(i, idx)));
                }
                var mark = document.createElement('mark');
                mark.className = 'lom-mark';
                mark.textContent = orig.slice(idx, idx + q.length);
                frag.appendChild(mark);
                i = idx + q.length;
                idx = lower.indexOf(q, i);
            }
            frag.appendChild(document.createTextNode(orig.slice(i)));
            el.textContent = '';
            el.appendChild(frag);
        });
    }

    function applyFilter() {
        var q = state.q;
        var all = Array.prototype.slice.call(root.querySelectorAll('.lom-node'));
        all.slice().reverse().forEach(function(n) {
            var self = !!q && (n.getAttribute('data-search') || '').indexOf(q) !== -1;
            var desc = false;
            var kids = n.querySelectorAll('.lom-node');
            for (var i = 0; i < kids.length; i++) {
                if (kids[i].lomHit) {
                    desc = true;
                    break;
                }
            }
            n.lomSelf = self;
            n.lomDesc = desc;
            n.lomHit = self || desc;
        });
        all.forEach(function(n) {
            var show = true;
            if (q) {
                var ancSelf = false;
                var p = n.parentElement;
                while (p && p !== root) {
                    if (p.classList.contains('lom-node') && p.lomSelf) {
                        ancSelf = true;
                        break;
                    }
                    p = p.parentElement;
                }
                show = n.lomHit || ancSelf;
            }
            n.classList.toggle('lom-hidden', !show);
            n.classList.toggle('lom-open-search', !!q && n.lomDesc && !n.lomSelf);
        });
        Array.prototype.forEach.call(root.querySelectorAll('.lom-group'), function(g) {
            var visible = !q;
            if (q) {
                var kids = g.querySelectorAll('.lom-node');
                for (var i = 0; i < kids.length; i++) {
                    if (!kids[i].classList.contains('lom-hidden')) {
                        visible = true;
                        break;
                    }
                }
            }
            g.classList.toggle('lom-hidden', !visible);
        });
        var active = state.unmappedOnly ? views.unmapped : views[state.view];
        var any = false;
        if (active) {
            var cards = active.querySelectorAll('.lom-card, .lom-node');
            for (var i = 0; i < cards.length; i++) {
                if (!cards[i].classList.contains('lom-hidden')) {
                    any = true;
                    break;
                }
            }
        }
        noresults.classList.toggle('lom-hidden', !q || any);
        syncChevrons();
        applyHighlight(q);
    }

    function render() {
        views.program.classList.toggle('lom-hidden', state.unmappedOnly || state.view !== 'program');
        views.course.classList.toggle('lom-hidden', state.unmappedOnly || state.view !== 'course');
        views.unmapped.classList.toggle('lom-hidden', !state.unmappedOnly);
        Array.prototype.forEach.call(root.querySelectorAll('[data-lom-view]'), function(btn) {
            var active = !state.unmappedOnly && btn.getAttribute('data-lom-view') === state.view;
            btn.classList.toggle('lom-active', active);
            btn.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        if (chip) {
            chip.classList.toggle('lom-active', state.unmappedOnly);
            chip.setAttribute('aria-pressed', state.unmappedOnly ? 'true' : 'false');
        }
        if (callout) {
            callout.classList.toggle('lom-hidden',
                state.unmappedOnly || state.view !== 'program' || !!state.q);
        }
        clearBtn.classList.toggle('lom-hidden', !state.q);
        applyFilter();
    }

    function buildPanel(templateId, row) {
        var tpl = document.getElementById(templateId);
        if (!tpl) {
            return null;
        }
        var frag = tpl.content.cloneNode(true);
        var form = frag.querySelector('form');
        var itemid = row.getAttribute('data-itemid');
        form.querySelector('input[name=itemid]').value = itemid;
        form.id = 'lom-panel-' + itemid + '-' + templateId.replace(/[^a-zA-Z0-9_-]/g, '-');
        return form;
    }

    function connectPanelTrigger(trigger, form) {
        activePanelTrigger = trigger;
        trigger.setAttribute('aria-expanded', 'true');
        trigger.setAttribute('aria-controls', form.id);
    }

    function openPicker(row, trigger) {
        var slot = row.nextElementSibling;
        if (!slot || !slot.classList.contains('lom-inline-slot')) {
            return;
        }
        if (slot.getAttribute('data-panel') === 'map') {
            closePanels(true);
            return;
        }
        closePanels(false);
        var form = buildPanel('lom-picker-' + row.getAttribute('data-picker'), row);
        if (!form) {
            return;
        }
        var mapped = [];
        try {
            mapped = JSON.parse(row.getAttribute('data-mapped') || '[]');
        } catch (e) {
            mapped = [];
        }
        Array.prototype.forEach.call(form.querySelectorAll('input[type=checkbox]'), function(box) {
            if (mapped.indexOf(parseInt(box.value, 10)) !== -1) {
                box.checked = true;
                box.disabled = true;
                var label = box.closest('label');
                label.classList.add('lom-locked');
                label.title = root.getAttribute('data-lockedmsg');
                var explanation = document.createElement('span');
                explanation.className = 'visually-hidden';
                explanation.textContent = root.getAttribute('data-lockedmsg');
                label.appendChild(explanation);
            }
        });
        slot.setAttribute('data-panel', 'map');
        slot.appendChild(form);
        connectPanelTrigger(trigger, form);
        var firstcontrol = form.querySelector('input[type=checkbox]:not([disabled]), button');
        if (firstcontrol) {
            firstcontrol.focus();
        }
    }

    function openEdit(row, trigger) {
        var slot = row.nextElementSibling;
        if (!slot || !slot.classList.contains('lom-inline-slot')) {
            return;
        }
        if (slot.getAttribute('data-panel') === 'edit') {
            closePanels(true);
            return;
        }
        closePanels(false);
        var form = buildPanel('lom-edit-template', row);
        if (!form) {
            return;
        }
        form.querySelector('input[name=statement]').value = row.getAttribute('data-statement');
        form.querySelector('[data-lom-editnote]').textContent = row.getAttribute('data-editnote');
        slot.setAttribute('data-panel', 'edit');
        slot.appendChild(form);
        connectPanelTrigger(trigger, form);
        form.querySelector('input[name=statement]').focus();
    }

    root.addEventListener('click', function(e) {
        var target = e.target;
        var viewBtn = target.closest('[data-lom-view]');
        if (viewBtn) {
            state.view = viewBtn.getAttribute('data-lom-view');
            state.unmappedOnly = false;
            render();
            return;
        }
        if (target.closest('[data-lom-review]')) {
            state.unmappedOnly = true;
            render();
            return;
        }
        if (target.closest('[data-lom-backfull]')) {
            state.unmappedOnly = false;
            render();
            return;
        }
        if (target.closest('[data-lom-close]')) {
            e.preventDefault();
            closePanels(true);
            return;
        }
        var mapButton = target.closest('[data-lom-map]');
        if (mapButton) {
            e.preventDefault();
            openPicker(mapButton.closest('.lom-row'), mapButton);
            return;
        }
        var editButton = target.closest('[data-lom-edit]');
        if (editButton) {
            e.preventDefault();
            openEdit(editButton.closest('.lom-row'), editButton);
            return;
        }
        var toggle = target.closest('[data-lom-toggle]');
        if (!toggle) {
            var rowToggle = target.closest('.lom-row-toggle');
            if (rowToggle && !target.closest('a, input, label, form')
                    && !(target.closest('button') && !target.closest('[data-lom-toggle]'))) {
                toggle = rowToggle;
            }
        }
        if (toggle) {
            var node = toggle.closest('.lom-node');
            if (node) {
                node.classList.toggle('lom-open');
                syncChevrons();
            }
        }
    });

    root.addEventListener('keydown', function(e) {
        if ((e.key === 'Escape' || e.key === 'Esc') && e.target.closest('.lom-panel')) {
            e.preventDefault();
            closePanels(true);
        }
    });

    if (chip) {
        chip.addEventListener('click', function() {
            state.unmappedOnly = !state.unmappedOnly;
            render();
        });
    }
    searchInput.addEventListener('input', function() {
        state.q = searchInput.value.trim().toLowerCase();
        render();
    });
    clearBtn.addEventListener('click', function() {
        searchInput.value = '';
        state.q = '';
        render();
        searchInput.focus();
    });

    var firstPlo = views.program.querySelector('.lom-plo');
    if (firstPlo) {
        firstPlo.classList.add('lom-open');
    }
    render();
})();
{{/js}}
